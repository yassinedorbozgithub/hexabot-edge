{
  "extends": "@hexabot-ai/tsconfig/react.json",
  "compilerOptions": {
    "target": "ES2017",
    "allowJs": true,
    "noImplicitAny": false,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["vite-env.d.ts", "**/*.ts", "**/*.tsx", "global.d.ts"],
  "exclude": ["node_modules", "vite.config.mts", "../widget"]
}
