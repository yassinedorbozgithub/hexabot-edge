{
  "name": "@hexabot-ai/cli",
  "version": "3.5.0",
  "description": "Official Hexabot CLI for creating and managing AI chatbot/agent projects built with Hexabot.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hexabot": "dist/index.js"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "keywords": [],
  "author": "Hexastack",
  "license": "FCL-1.0-ALv2",
  "lint-staged": {
    "*.{ts}": "eslint --fix --config eslint.config-staged.cjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@xhmikosr/decompress": "^11.1.3",
    "axios": "^1.20.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.12.0"
  },
  "devDependencies": {
    "@hexabot-ai/eslint-config": "workspace:*",
    "@hexabot-ai/tsconfig": "workspace:*",
    "@jest/globals": "^30.5.2",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "jest": "^30.5.2",
    "lint-staged": "^15.3.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
