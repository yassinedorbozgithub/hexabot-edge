{
  "extends": "@hexabot-ai/tsconfig/react.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "types": ["vite/client", "node"],
    /* Typecheck against workspace sources, as the API and frontend do, so it
       does not depend on `@hexabot-ai/types` being built first. */
    "paths": {
      "@hexabot-ai/types": ["../types/src"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../types/src"],
  "exclude": ["../types/src/**/*.test.ts"]
}
