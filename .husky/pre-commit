RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color


run_checks() {
    local path=packages/$1
    local changes=$(git diff --cached --name-only | grep "^${path}/" || true)
    if [ -n "$changes" ]; then
        echo "${BLUE}Running ${path} checks and tests...${NC}"
        cd ./${path} 
        if [ "$path" = "packages/api" ]; then
            pnpm barrels || exit 1
        fi
        pnpm typecheck
        cd - > /dev/null
    else
        echo "${YELLOW}No changes detected in ${path}, skipping checks and tests.${NC}"
    fi
}

echo "${BLUE}Running pre-commit checks...${NC}"
echo ""
run_checks "widget"
run_checks "frontend"
run_checks "graph"
run_checks "cli"
run_checks "agentic"
run_checks "types"
run_checks "api" 
pnpm exec lint-staged # uses the closest lint-staged.config.mjs per file
echo "\n${GREEN}Pre-commit checks completed successfully.${NC}\n"
